# syntax=docker/dockerfile:1

# --- Stage 1: build the SPA ---
FROM node:26-alpine AS ui
WORKDIR /app/ui
COPY ui/package.json ui/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY ui/ ./
RUN npm run build

# --- Stage 2: build the Go binary (pure-Go, no cgo) with the embedded SPA ---
FROM golang:1.27-alpine AS build
WORKDIR /app/backend
# The runtime's empty /data (distroless has no shell to make one).
RUN mkdir -p /out/data
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend/ ./
# The real Vite bundle into backend/web/dist (the context leaves the host's out, .dockerignore), so
# //go:embed all:dist bakes the production UI into the binary. ui/vite.config.ts builds straight to
# ../backend/web/dist, so from the ui stage's WORKDIR that lands at /app/backend/web/dist.
COPY --from=ui /app/backend/web/dist ./web/dist
# The song dataset, embedded and upserted at boot: go:embed cannot reach ../data, so it is copied in.
COPY data/songs.jsonl ./internal/dataset/files/songs.jsonl
# ship release passes the release version; declared last, and with the build cache mounted, a new version
# recompiles nothing that did not change.
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/trick77/ship/kit/version.Version=${VERSION}" -o /out/reworm ./cmd/reworm

# --- Stage 3: minimal runtime, distroless nonroot (uid/gid 65532) ---
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/reworm /reworm
# Owned by the runtime user: `docker run` without a volume works, and a fresh named volume takes this owner.
COPY --from=build --chown=65532:65532 /out/data /data
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/reworm"]
