# Copy to .env next to compose.yaml (never committed). compose.yaml and compose.dev.yaml both read it.

# --- Server ---
# Hostname Traefik routes reworm on (compose.yaml Host rule) and the base of the pairing QR links.
# Unset (compose.dev.yaml): plain http on localhost, pairing links are path-only.
PUBLIC_FQDN=reworm.example.com
# debug | info | warn | error
BACKEND_LOG_LEVEL=info

# --- Song import (dev machine only, `make import-songs`; not read by the server) ---
# Keep these in the uncommitted .env.local, not here: the card-list source stays out of the repo.
# BACKEND_LASTFM_API_KEY=
# BACKEND_CARDS_BASE_URL=
# BACKEND_CARDS_FILES=
