# Copy to .env next to compose.yaml (never committed; compose.dev.yaml does not read it). The server container
# gets all of it, so only server settings belong here; the importer's keys and the card-list source stay in the
# uncommitted .env.local.

# Hostname Traefik routes reworm on (compose.yaml Host rule) and the base of the pairing QR links. Required:
# left empty, `docker compose up` stops and says so.
PUBLIC_FQDN=

# debug | info | warn | error
BACKEND_LOG_LEVEL=info
